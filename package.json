{
  "name": "wot-da-shrine",
  "version": "2.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "Wot Da Shrine: pray for uptime, together. A shrine your team keeps so the servers stay up, and prays at when they don't.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "test": "node --test --test-force-exit --test-timeout=60000 \"test/**/*.test.js\"",
    "check:size": "node scripts/check-size.js",
    "check": "npm run check:size && npm test && npm run build",
    "vapid": "node scripts/vapid.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "hono": "^4.13.16",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "vite": "^8.3.4",
    "wrangler": "^4.152.0"
  }
}
