{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wot-da-shrine",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The API, /new and room pages need code (a room page gets its link preview rewritten); everything
    // else comes straight from the asset store, with headers from public/_headers.
    "run_worker_first": ["/api/*", "/new", "/r/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SHRINE", "class_name": "Shrine" },
      { "name": "WORLD", "class_name": "World" },
      { "name": "PAIRING", "class_name": "Pairing" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Shrine"] },
    { "tag": "v2", "new_sqlite_classes": ["World"] },
    { "tag": "v3", "new_sqlite_classes": ["Pairing"] }
  ],
  // Per-IP limits, counted per Cloudflare location. Sockets get more room than /new because a whole
  // office behind one NAT may pile into the same shrine (and the client reconnects with backoff).
  "ratelimits": [
    { "name": "NEW_ROOM_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SOCKET_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "PAIR_LIMIT", "namespace_id": "1004", "simple": { "limit": 12, "period": 60 } }
  ],
  "observability": {
    "enabled": true
  },
  // Served only on its own hostname (the wotdafong.dev zone must be on this Cloudflare account):
  // no *.workers.dev URL and no per-version preview URLs.
  "routes": [{ "pattern": "shrine.wotdafong.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
