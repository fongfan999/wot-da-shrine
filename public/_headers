# Headers for the static site, applied at the edge: pages and files are served
# without waking the Worker (see run_worker_first in wrangler.jsonc).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Hashed Vite bundles never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=86400

# Pictures: the link preview cards (og*.png), the chat card's thumbnail of one (og-thumb.jpg, the
# card is 270 KB and shown 120px wide) and the icons change rarely; chat apps cache them anyway.
# One rule each: two rules that both match join their values.
/*.png
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400

# The service worker is checked for a new version on every visit; it must never be stale for a day.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: public, max-age=3600
