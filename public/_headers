# Headers for the static site, applied at the edge: pages and files are served
# without waking the Worker (see run_worker_first in wrangler.jsonc).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Hashed Vite bundles never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=86400

# The link preview cards change rarely; chat apps cache them anyway.
/og.png
  Cache-Control: public, max-age=86400
/og-down.png
  Cache-Control: public, max-age=86400
/og-back.png
  Cache-Control: public, max-age=86400

# The service worker is checked for a new version on every visit; it must never be stale for a day.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: public, max-age=3600
